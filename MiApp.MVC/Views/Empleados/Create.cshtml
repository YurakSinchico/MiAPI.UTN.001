@using MiApp.UTN.Modelos

@model Empleado

@{
    ViewData["Title"] = "Nuevo Empleado";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Nuevo Empleado</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@if (ViewData["Message"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>¡Atención!</strong> @ViewData["Message"]
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PersonaId" class="form-label">Persona</label>
                <select asp-for="PersonaId" asp-items="@ViewBag.selectlistPersonas" class="form-select">
                    <option selected="selected" value="">-- Elija una persona --</option>
                </select>
                <span asp-validation-for="PersonaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CargoId" class="form-label">Cargo</label>
                <select asp-for="CargoId" asp-items="@ViewBag.selectlistCargos" class="form-select">
                    <option selected="selected" value="">-- Elija un cargo --</option>
                </select>
                <span asp-validation-for="CargoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label">Fecha de Ingreso</label>
                <input asp-for="FechaIngreso" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaIngreso" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Salario" class="form-label">Salario</label>
                <input asp-for="Salario" class="form-control" type="number" step="0.01" placeholder="Ej. 2500" />
                <span asp-validation-for="Salario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Comision" class="form-label">Comisión</label>
                <input asp-for="Comision" class="form-control" type="number" step="0.01" placeholder="Ej. 25" />
                <span asp-validation-for="Comision" class="text-danger"></span>
            </div>

            <hr />

            <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}